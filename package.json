  "author": "jjoo",
  "dependencies": {
    "algoliasearch": "^5.65.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "i18next": "^23.16.8",
    "lodash": "^4.18.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "5.4.0",
    "react-share": "^5.3.0",
    "sass": "^1.108.2"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "gatsby clean",
    "build": "gatsby clean && gatsby build --prefix-paths",
    "build:inspect": "npm run clean && node --inspect-brk node_modules/.bin/gatsby build --prefix-paths",
    "develop": "gatsby develop -H 0.0.0.0",
    "develop:inspect": "npm run clean && node --inspect-brk --no-lazy node_modules/.bin/gatsby develop",
    "serve": "gatsby serve --prefix-paths -H 0.0.0.0",
    "generate": "node scripts/post-generator/index.js",
    "format": "prettier --trailing-comma es5 --write \"{gatsby-*.{js,ts},src/**/*.{js,jsx,ts,tsx}}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-helmet": "^6.1.11",
    "gatsby": "^5.16.1",
    "gatsby-plugin-canonical-urls": "^5.16.0",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-twitter": "^5.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-embed-video": "^3.2.1",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "prettier": "^3.10.1",
    "sass-loader": "^16.0.8",
    "typescript": "^5.9.3"
